# =============================================================================
# Inventory — GOODS RECEIVED (VS Code REST Client) — POST /api/v1/stores/{storeId}/inventory/products/{productPublicId}/received (STORE ADMIN or ADMIN)
# =============================================================================
# Semantics: a delivery landed — additive by definition (ticket 0012, Q5).
# You send the delivered count (>= 1); the service adds it to the shelf and
# records a RECEIVED movement with before/after. Receiving zero is rejected
# at the payload layer: a zero delivery is a no-op, not a delivery. Guard
# order: store visibility (404 unknown/closed), identity (403), listing gate
# (404 "Product not found"), then the row (404 "Inventory not found").
#
# How to run:
#   1. Start the backend: `docker compose up -d --build` — http://localhost:4000
#   2. Click the "Send Request" CodeLens above any request, IN ORDER, in one
#      sitting (captures are session-scoped).
#
# Prerequisites (admin persona):
#   Signup admin@devtunde.com with Password123! once, then promote in MySQL:
#     update users set role = 'ROLE_ADMIN' where email = 'admin@devtunde.com';
#
# Notes:
#   - All data is FAKE (devtunde.com emails, Nigerian numbers).
#   - The automated suites: InventoryApiTests, InventoryLifecycleTests.
#   - Re-runnable: manager, brand, category, SKU and contact emails are minted
#     with {{$timestamp}} — no 409 collisions with prior runs.
#   - Access tokens expire after 15 MINUTES. If tokened requests suddenly 401,
#     re-send the SETUP requests from the top.
#   - REST Client captures die on file/VS Code reopen — re-send the setup
#     requests from the top; never continue on a dead capture.
#   - Expected codes: 200 received, 400 invalid payload, 401 no/invalid token,
#     403 wrong identity, 404 unknown/closed store, unlisted product, or
#     listed-but-unstocked pair.
# =============================================================================

@baseUrl = http://localhost:4000/api/v1
@authUrl = http://localhost:4000/api/v1/auth

### 1 — Setup: login the admin persona
# Expected: 200
# @name adminLogin
POST {{authUrl}}/login
Content-Type: application/json

{
  "email": "admin@devtunde.com",
  "password": "Password123!"
}

### 2 — Setup: signup the store manager (minted fresh each run)
# Expected: 201
# @name mgrSignup
POST {{authUrl}}/signup
Content-Type: application/json

{
  "fullName": "Received Probe Manager",
  "email": "probe-recv-mgr-{{$timestamp}}@devtunde.com",
  "password": "Password123!",
  "phone": "+2348031234601"
}

### 3 — Setup: login the manager
# Expected: 200
# @name mgrLogin
POST {{authUrl}}/login
Content-Type: application/json

{
  "email": "{{mgrSignup.response.body.user.email}}",
  "password": "Password123!"
}

### 4 — Setup: create the store
# Expected: 201
# @name storeOk
POST {{baseUrl}}/stores
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.accessToken}}

{
  "brand": "Received Probe Store {{$timestamp}}",
  "description": "Probe store for deliveries",
  "storeType": "BRANCH",
  "storeAdminPublicId": "{{mgrLogin.response.body.user.publicId}}",
  "contact": {
    "address": "12 Market Road, Lagos",
    "phone": "08012345678",
    "email": "received-probe-{{$timestamp}}@devtunde.com"
  }
}

### 5 — Setup: create a category
# Expected: 201
# @name catOk
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.accessToken}}

{
  "name": "Received Category {{$timestamp}}"
}

### 6 — Setup: list a product in the store
# Expected: 201
# @name listingOk
POST {{baseUrl}}/products/store/{{storeOk.response.body.publicId}}
Content-Type: application/json
Authorization: Bearer {{mgrLogin.response.body.accessToken}}

{
  "name": "Received Milk",
  "sku": "SKU-RC-{{$timestamp}}",
  "description": "Milk for delivery probes",
  "brand": "DairyCo",
  "image": "https://cdn.devtunde.com/milk.png",
  "categoryPublicId": "{{catOk.response.body.publicId}}",
  "mrp": 15000.00,
  "sellingPrice": 12000.00
}

### 7 — Setup: create stock (100 on shelf, threshold 10)
# Expected: 201
POST {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory
Content-Type: application/json
Authorization: Bearer {{mgrLogin.response.body.accessToken}}

{
  "productPublicId": "{{listingOk.response.body.publicId}}",
  "quantity": 100,
  "lowStockThreshold": 10
}

### 8 — First delivery: 50 units
# Expected: 200 — quantity 150; RECEIVED movement (before 100, after 150)
POST {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/products/{{listingOk.response.body.publicId}}/received
Content-Type: application/json
Authorization: Bearer {{mgrLogin.response.body.accessToken}}

{
  "quantity": 50
}

### 9 — Second delivery: 25 more — receptions are additive, never replacements
# Expected: 200 — quantity 175
POST {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/products/{{listingOk.response.body.publicId}}/received
Content-Type: application/json
Authorization: Bearer {{mgrLogin.response.body.accessToken}}

{
  "quantity": 25
}

### 10 — Zero-unit delivery
# Expected: 400 — field error on quantity (@Min(1)): a zero delivery is a no-op
POST {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/products/{{listingOk.response.body.publicId}}/received
Content-Type: application/json
Authorization: Bearer {{mgrLogin.response.body.accessToken}}

{
  "quantity": 0
}

### 11 — Negative delivery
# Expected: 400 — field error on quantity; deliveries never drain stock
POST {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/products/{{listingOk.response.body.publicId}}/received
Content-Type: application/json
Authorization: Bearer {{mgrLogin.response.body.accessToken}}

{
  "quantity": -5
}

### 12 — Missing quantity entirely
# Expected: 400 — a delivery without a count is not a delivery
POST {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/products/{{listingOk.response.body.publicId}}/received
Content-Type: application/json
Authorization: Bearer {{mgrLogin.response.body.accessToken}}

{
}

### 13 — No Authorization header
# Expected: 401
POST {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/products/{{listingOk.response.body.publicId}}/received
Content-Type: application/json

{
  "quantity": 50
}

### 14 — Garbage token
# Expected: 401
POST {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/products/{{listingOk.response.body.publicId}}/received
Content-Type: application/json
Authorization: Bearer not-a-real-jwt

{
  "quantity": 50
}

### 15 — Setup: signup the regular persona (fixed — she never holds a seat)
# Expected: 201 (409 if she already exists — either way the account exists)
# @name regularSignup
POST {{authUrl}}/signup
Content-Type: application/json

{
  "fullName": "Bola Storeless",
  "email": "bola.storeless@devtunde.com",
  "password": "Password123!",
  "phone": "+2348031234571"
}

### 16 — Setup: login the regular persona (fixed — she never holds a seat)
# Expected: 200
# @name regularLogin
POST {{authUrl}}/login
Content-Type: application/json

{
  "email": "bola.storeless@devtunde.com",
  "password": "Password123!"
}

### 17 — Receive goods as a regular user
# Expected: 403 — identity gate
POST {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/products/{{listingOk.response.body.publicId}}/received
Content-Type: application/json
Authorization: Bearer {{regularLogin.response.body.accessToken}}

{
  "quantity": 50
}

### 18 — Unknown product: the listing gate fires first
# Expected: 404 — title "Product not found"
POST {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/products/11111111-1111-1111-1111-111111111111/received
Content-Type: application/json
Authorization: Bearer {{mgrLogin.response.body.accessToken}}

{
  "quantity": 50
}

### 19 — Setup: list a second product but never stock it
# Expected: 201
# @name listingUnstocked
POST {{baseUrl}}/products/store/{{storeOk.response.body.publicId}}
Content-Type: application/json
Authorization: Bearer {{mgrLogin.response.body.accessToken}}

{
  "name": "Unstocked Received Milk",
  "sku": "SKU-RU-{{$timestamp}}",
  "description": "Listed, shelf never counted",
  "brand": "DairyCo",
  "image": "https://cdn.devtunde.com/milk.png",
  "categoryPublicId": "{{catOk.response.body.publicId}}",
  "mrp": 8000.00,
  "sellingPrice": 7500.00
}

### 20 — Listed but unstocked: no shelf to receive onto
# Expected: 404 — title "Inventory not found" (distinct from "Product not found")
POST {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/products/{{listingUnstocked.response.body.publicId}}/received
Content-Type: application/json
Authorization: Bearer {{mgrLogin.response.body.accessToken}}

{
  "quantity": 50
}

### 21 — Unknown store
# Expected: 404 — title "Store not found"
POST {{baseUrl}}/stores/22222222-2222-2222-2222-222222222222/inventory/products/{{listingOk.response.body.publicId}}/received
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.accessToken}}

{
  "quantity": 50
}

### 22 — Close the store, then receive goods
# Expected: 204
DELETE {{baseUrl}}/stores/{{storeOk.response.body.publicId}}
Authorization: Bearer {{adminLogin.response.body.accessToken}}

### 23 — Closed store: gone even for its own admin
# Expected: 404 — title "Store not found"
POST {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/products/{{listingOk.response.body.publicId}}/received
Content-Type: application/json
Authorization: Bearer {{mgrLogin.response.body.accessToken}}

{
  "quantity": 50
}
