### 14 — The report: tiers split exactly
# Expected: 200 — low[] has 1 item (Dwindling Milk, 8/10); out[] has 2 items
# (Gone Milk 0/10 and Zero Watch Milk 0/0); Healthy Milk is in neither tier
GET {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/low-stock
Authorization: Bearer {{mgrLogin.response.body.accessToken}}

### 15 — No Authorization header
# Expected: 401
GET {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/low-stock

### 16 — Garbage token
# Expected: 401
GET {{baseUrl}}/stores/{{storeOk.response.body.publicId}}/inventory/low-stock
Authorization: Bearer not-a-real-jwt

