# ── POS BACKEND DB ────────────────────────────────────────────────────────
# Host-run app (mvnw) points at the compose MySQL published on 127.0.0.1:3307.
# Inside Docker the backend gets jdbc:mysql://mysql:3306 instead (compose overrides).
POS_DB_URL=jdbc:mysql://127.0.0.1:3307/posbackend
POS_DB_USER=pos
POS_DB_PASSWORD=
POS_DB_NAME=posbackend
POS_DB_PORT=3307
# Root password: used ONLY by docker-compose to provision the MySQL container
POS_DB_ROOT_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────
# Raw HMAC secret for HS512, at least 64 characters (512 bits)
AUTH_JWT_SECRET=

# ── ERROR ────────────────────────────────────────────────────────────────
# Base URL for RFC 7807 problem 'type' fields, e.g. https://pos.devtunde.com/errors
ERRORS_BASE_URL=
