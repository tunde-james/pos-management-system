# ── POS BACKEND DB ────────────────────────────────────────────────────────
# Host-run app (mvnw) points at the compose MySQL published on 127.0.0.1:3307.
# Inside Docker the backend gets jdbc:mysql://mysql:3306 instead (compose overrides).
POS_DB_URL=jdbc:mysql://127.0.0.1:3307/posbackend
POS_DB_USER=pos
POS_DB_PASSWORD=
POS_DB_NAME=posbackend
POS_DB_PORT=3307
# Root password: used ONLY by docker-compose to provision the MySQL container
POS_DB_ROOT_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────
# Raw HMAC secret for HS512, at least 64 characters (512 bits)
AUTH_JWT_SECRET=

# ── ERROR ────────────────────────────────────────────────────────────────
# Base URL for RFC 7807 problem 'type' fields, e.g. https://pos.devtunde.com/errors
ERRORS_BASE_URL=

# ── EMAIL (SMTP) ─────────────────────────
# Leave unset in dev/tests/CI: no JavaMailSender bean is created and the
# low-stock scheduler fails soft (logs a WARN, sends nothing).
# Set these only where a real SMTP server exists (e.g. deployment):
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# Always set FINITE timeouts when SPRING_MAIL_HOST is set - JavaMail defaults
# are infinite; a hung SMTP server would block the alert scan thread:
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=5000
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=60000
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=10000

# Required for authenticated relays (Gmail/Brevo/Mailtrap all need both):
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_STARTTLS_ENABLE=true

# Keep SMTP OUT of container health (fail-soft: a broken relay must never mark
# the app DOWN). Durable home is application.yml (management.health.mail.enabled:
# false); this env var is the dev-stack lever:
# MANAGEMENT_HEALTH_MAIL_ENABLED=false
